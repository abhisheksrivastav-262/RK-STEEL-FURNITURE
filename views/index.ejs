<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= settings.businessName %> | Strong, Stylish & Durable Steel Furniture</title>
    <meta name="description" content="<%= settings.businessName %> offers premium steel almirahs, wardrobes, dressing tables and office furniture with 100+ modern designs, direct manufacturer pricing, home delivery and Cash on Delivery in <%= settings.location %>.">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="preload" href="/css/styles.css" as="style">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <!-- Header -->
    <header class="header">
        <div class="container header-content">
            <a href="#" class="logo">
                <img src="/assets/<%= settings.logo %>" alt="<%= settings.businessName %> Logo" class="brand-logo">
                <span class="logo-text"><%= settings.businessName %></span>
            </a>
            
            <nav class="nav-menu">
                <ul>
                    <li><a href="#home">Home</a></li>
                    <li><a href="#products">Products</a></li>
                    <li><a href="#cod">Cash on Delivery</a></li>
                    <li><a href="#about">About Us</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
                <div class="mobile-actions d-none">
                    <a href="tel:+<%= settings.whatsapp.replace(/[^0-9]/g, "") %>" class="btn btn-primary w-100 mb-2"><i class="fa-solid fa-phone"></i> Call Now</a>
                    <a href="https://wa.me/<%= settings.whatsapp.replace(/[^0-9]/g, "") %>" class="btn btn-whatsapp-solid w-100" target="_blank"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
                </div>
            </nav>
            
            <div class="header-actions">
                <a href="tel:+<%= settings.whatsapp.replace(/[^0-9]/g, "") %>" class="btn btn-call"><i class="fa-solid fa-phone"></i> Call Now</a>
                <a href="https://wa.me/<%= settings.whatsapp.replace(/[^0-9]/g, "") %>" class="btn btn-whatsapp" target="_blank"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
            </div>

            <button class="mobile-menu-btn" aria-label="Toggle menu">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="home" class="hero" style="background-image: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1555041469-a586c61ea9bc?q=80&w=1080&auto=format&fit=crop');">
        <div class="container hero-content">
            <h1 class="fade-in-up"><%= settings.businessName %></h1>
            <h2 class="fade-in-up delay-1">STRONG • STYLISH • DURABLE</h2>
            <p class="fade-in-up delay-2"><%= settings.tagline2 %></p>
            <div class="delivery-hero-badge fade-in-up delay-2">
                <p><strong><i class="fa-solid fa-truck"></i> FREE HOME DELIVERY WITHIN 30 KM</strong></p>
                <p style="font-size: 0.9rem;">From <%= settings.location %></p>
            </div>
            <div class="hero-buttons fade-in-up delay-3">
                <a href="#showroom" class="btn btn-primary">Visit Our Showroom</a>
                <a href="https://wa.me/<%= settings.whatsapp.replace(/[^0-9]/g, "") %>" class="btn btn-whatsapp-solid" target="_blank"><i class="fa-brands fa-whatsapp"></i> WhatsApp Now</a>
            </div>
        </div>
    </section>

    <!-- Hero Feature Highlights -->
    <section class="feature-highlights">
        <div class="container">
            <div class="highlight-grid">
                <div class="highlight-card">
                    <i class="fa-solid fa-medal"></i>
                    <h3>Premium Quality Steel</h3>
                    <p>Strong and durable steel furniture made for long-term use.</p>
                </div>
                <div class="highlight-card">
                    <i class="fa-solid fa-truck-fast"></i>
                    <h3>Home Delivery</h3>
                    <p>Convenient and reliable delivery service.</p>
                </div>
                <div class="highlight-card">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                    <h3>Cash on Delivery</h3>
                    <p>Pay safely at the time of delivery.</p>
                </div>
                <div class="highlight-card">
                    <i class="fa-solid fa-store"></i>
                    <h3>Visit Our Showroom</h3>
                    <p>Visit our showroom and check the quality yourself.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Trust / USP Bar -->
    <section class="usp-bar">
        <div class="container usp-container">
            <div class="usp-item"><i class="fa-solid fa-star"></i> 100+ Modern Designs</div>
            <div class="usp-item"><i class="fa-solid fa-thumbs-up"></i> Best Price Guarantee</div>
            <div class="usp-item"><i class="fa-solid fa-industry"></i> Direct from Manufacturer</div>
            <div class="usp-item"><i class="fa-solid fa-shield-halved"></i> Long Life & Rust Free</div>
        </div>
    </section>

    <!-- Products Section -->
    <section id="products" class="products section-padding">
        <div class="container">
            <div class="section-title">
                <h2>OUR PRODUCTS</h2>
                <p>Premium Steel Furniture for Every Space</p>
            </div>
            
            <div class="product-grid">
                <% products.forEach(product => { %>
                <div class="product-card">
                    <div class="product-image">
                        <img src="<%= product.imageBase64 ? '/image/product/' + product.id : (product.image && product.image.startsWith('http') ? product.image : '/assets/' + product.image) %>" alt="<%= product.name %>" loading="lazy" decoding="async">
                        <% if (product.featured) { %><span class="badge badge-gold">Featured</span><% } %>
                    </div>
                    <div class="product-info">
                        <h3><%= product.name %></h3>
                        <p><%= product.description %></p>
                        <% if (settings.freeDelivery === 'true') { %><p class="delivery-product-badge"><i class="fa-solid fa-truck"></i> Free Delivery within <%= settings.deliveryRadius %></p><% } %>
                        <p class="product-price">Starting From <strong><%= product.price %></strong></p>
                        <a href="https://wa.me/<%= settings.whatsapp.replace(/[^0-9]/g, "") %>?text=<%= encodeURIComponent(product.whatsappMsg) %>" class="btn btn-outline-gold" target="_blank">View More</a>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- Cash on Delivery Section -->
    <section id="cod" class="cod-section">
        <div class="container cod-container">
            <div class="cod-icon">
                <i class="fa-solid fa-truck"></i>
            </div>
            <div class="cod-content">
                <h2>CASH ON DELIVERY</h2>
                <h3>Pay at Your Doorstep</h3>
                <p class="delivery-cod-badge">
                    <strong><i class="fa-solid fa-truck text-gold"></i> Free Home Delivery within 30 KM</strong><br>
                    Available within a 30 KM radius of <%= settings.location %>.
                </p>
                <ul class="cod-points">
                    <li><i class="fa-solid fa-check"></i> Safe</li>
                    <li><i class="fa-solid fa-check"></i> Secure</li>
                    <li><i class="fa-solid fa-check"></i> Reliable</li>
                </ul>
                <a href="https://wa.me/<%= settings.whatsapp.replace(/[^0-9]/g, "") %>?text=Hello%20RK%20Steel%20Furniture,%20I%20am%20interested%20in%20your%20steel%20furniture%20products.%20Please%20share%20the%20available%20designs%20and%20prices." class="btn btn-primary" target="_blank">Order Now</a>
            </div>
        </div>
    </section>

    <!-- Showroom Section -->
    <% if (sections.showroom && sections.showroom.isVisible) { %><section id="showroom" class="showroom-section">
        <div class="container">
            <div class="showroom-grid">
                <div class="showroom-image">
                    <img src="/assets/<%= sections.showroom.image || 'b.png' %>" alt="<%= settings.businessName %> Showroom" style="object-fit: contain;" loading="lazy" decoding="async">
                </div>
                <div class="showroom-content">
                    <h2><%= sections.showroom.heading || 'VISIT OUR SHOWROOM' %></h2>
                    <p class="showroom-tagline"><%= sections.showroom.tagline || 'See the Quality, Feel the Strength, Choose the Best!' %></p>
                    <div class="location-card">
                        <i class="fa-solid fa-location-dot"></i>
                        <p>📍 <strong><%= settings.location %></strong></p>
                    </div>
                    <div class="showroom-actions">
                        <button class="btn btn-primary" onclick="alert('Google Maps link will be updated soon.')"><i class="fa-solid fa-map-location-dot"></i> Get Directions</button>
                        <a href="tel:+<%= settings.whatsapp.replace(/[^0-9]/g, "") %>" class="btn btn-outline-gold"><i class="fa-solid fa-phone"></i> Call</a>
                        <a href="https://wa.me/<%= settings.whatsapp.replace(/[^0-9]/g, "") %>" class="btn btn-whatsapp" target="_blank"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <% } %>

    <!-- About Us & Why Choose Us -->
    <section id="about" class="about-section section-padding">
        <div class="container">
            <div class="section-title text-center" style="margin-bottom: 2rem;">
                <h2>ABOUT <%= settings.businessName %></h2>
            </div>
            <div class="about-grid">
                <div class="about-content">
                    <p><%= settings.businessName %> specializes in strong, stylish and durable steel furniture designed for homes, offices and everyday use.</p>
                    <ul class="about-highlights">
                        <li><i class="fa-solid fa-gem text-gold"></i> Premium quality steel</li>
                        <li><i class="fa-solid fa-palette text-gold"></i> Modern designs</li>
                        <li><i class="fa-solid fa-dumbbell text-gold"></i> Strong construction</li>
                        <li><i class="fa-solid fa-clock text-gold"></i> Long-lasting products</li>
                        <li><i class="fa-solid fa-shield text-gold"></i> Rust-resistant finish</li>
                        <li><i class="fa-solid fa-tags text-gold"></i> Direct manufacturer pricing</li>
                        <li><i class="fa-solid fa-users text-gold"></i> Customer-focused service</li>
                        <li><i class="fa-solid fa-house text-gold"></i> Home delivery</li>
                        <li><i class="fa-solid fa-wallet text-gold"></i> Cash on Delivery</li>
                    </ul>
                </div>
                <div class="about-image">
                    <img src="https://images.unsplash.com/photo-1581428982868-e410dd047a90?q=80&w=800&auto=format&fit=crop" alt="<%= settings.businessName %> Manufacturing">
                </div>
            </div>

            <div class="why-choose-us" style="margin-top: 4rem;">
                <div class="section-title">
                    <h2>WHY CHOOSE <%= settings.businessName %>?</h2>
                </div>
                <div class="why-grid">
                    <div class="why-card">
                        <i class="fa-solid fa-dumbbell text-gold"></i>
                        <h4>Strong & Durable</h4>
                        <p>Built using quality steel for long-lasting performance.</p>
                    </div>
                    <div class="why-card">
                        <i class="fa-solid fa-palette text-gold"></i>
                        <h4>Modern Designs</h4>
                        <p>100+ modern designs to suit different interiors.</p>
                    </div>
                    <div class="why-card">
                        <i class="fa-solid fa-industry text-gold"></i>
                        <h4>Direct Manufacturer</h4>
                        <p>Get products directly from the manufacturer.</p>
                    </div>
                    <div class="why-card">
                        <i class="fa-solid fa-indian-rupee-sign text-gold"></i>
                        <h4>Best Price</h4>
                        <p>Competitive direct-manufacturer pricing.</p>
                    </div>
                    <div class="why-card">
                        <i class="fa-solid fa-shield text-gold"></i>
                        <h4>Rust Resistant</h4>
                        <p>Designed for long life with durable finishes.</p>
                    </div>
                    <div class="why-card">
                        <i class="fa-solid fa-truck-fast text-gold"></i>
                        <h4>Reliable Delivery</h4>
                        <p>Safe and convenient home delivery.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>



    <!-- Contact / Enquiry Section -->
    <section id="contact" class="contact-section section-padding">
        <div class="container">
            <div class="contact-wrapper">
                <div class="contact-info-panel">
                    <h2>GET IN TOUCH</h2>
                    <p>Have questions? Need a custom quote? We are here to help!</p>
                    <div class="contact-details">
                        <p><i class="fa-solid fa-phone text-gold"></i> <%= settings.phone %></p>
                        <p><i class="fa-brands fa-whatsapp text-green"></i> <%= settings.phone %></p>
                        <p><i class="fa-solid fa-location-dot text-gold"></i> <%= settings.location %></p>
                    </div>
                </div>
                <div class="contact-form-panel">
                    <form id="enquiry-form" class="enquiry-form">
                        <div class="form-group">
                            <label for="name">Name</label>
                            <input type="text" id="name" required placeholder="Your Name">
                        </div>
                        <div class="form-group">
                            <label for="phone">Phone Number</label>
                            <input type="tel" id="phone" required placeholder="Your Phone Number">
                        </div>
                        <div class="form-group">
                            <label for="product">Product Interested In</label>
                            <select id="product">
                                <option value="2 Door Steel Almirah">2 Door Steel Almirah</option>
                                <option value="3 Door Steel Almirah">3 Door Steel Almirah</option>
                                <option value="Mirror Almirah">Mirror Almirah</option>
                                <option value="2 / 3 Door Almirah">2 / 3 Door Almirah</option>
                                <option value="Dressing Table">Dressing Table</option>
                                <option value="Office Furniture">Office Furniture</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea id="message" rows="4" placeholder="Any specific requirements?"></textarea>
                        </div>
                        <button type="submit" class="btn btn-whatsapp-solid w-100"><i class="fa-brands fa-whatsapp"></i> Send Enquiry on WhatsApp</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Quick Contact CTA -->
    <section class="quick-cta">
        <div class="container text-center">
            <h2>Looking for Strong, Stylish & Durable Steel Furniture?</h2>
            <p>Choose from 100+ modern designs at direct manufacturer prices.</p>
            <div class="cta-buttons">
                <a href="tel:+<%= settings.whatsapp.replace(/[^0-9]/g, "") %>" class="btn btn-primary"><i class="fa-solid fa-phone"></i> Call Now</a>
                <a href="https://wa.me/<%= settings.whatsapp.replace(/[^0-9]/g, "") %>" class="btn btn-whatsapp-solid" target="_blank"><i class="fa-brands fa-whatsapp"></i> WhatsApp Now</a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container footer-top">
            <div class="footer-col brand-col">
                <div class="footer-logo">
                    <img src="/assets/<%= settings.logo %>" alt="<%= settings.businessName %> Logo" class="brand-logo">
                    <h3><%= settings.businessName %></h3>
                </div>
                <p class="tagline-1"><%= settings.tagline1 %></p>
                <p class="tagline-2"><%= settings.tagline2 %></p>
                <div class="social-links mt-3">
                    <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                </div>
            </div>
            
            <div class="footer-col links-col">
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="#home">Home</a></li>
                    <li><a href="#products">Products</a></li>
                    <li><a href="#cod">Cash on Delivery</a></li>
                    <li><a href="#about">About Us</a></li>
                    <li><a href="#contact">Contact</a></li>
                    <li><a href="/admin/login" class="text-gold" style="font-weight: 500;"><i class="fa-solid fa-lock" style="font-size: 0.8em; margin-right: 4px;"></i> Admin Panel</a></li>
                </ul>
            </div>
            
            <div class="footer-col contact-col">
                <h4>Contact Us</h4>
                <p><i class="fa-solid fa-phone text-gold"></i> <a href="tel:+<%= settings.whatsapp.replace(/[^0-9]/g, "") %>"><%= settings.phone %></a></p>
                <p><i class="fa-brands fa-whatsapp text-green"></i> <a href="https://wa.me/<%= settings.whatsapp.replace(/[^0-9]/g, "") %>" target="_blank"><%= settings.phone %></a></p>
                <p><i class="fa-solid fa-location-dot text-gold"></i> <%= settings.location %></p>
                <p class="mt-2" style="font-size: 0.9rem;"><i class="fa-solid fa-truck text-gold"></i> Free Home Delivery within 30 KM of <%= settings.location %></p>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p>&copy; 2026 <%= settings.businessName %>. All Rights Reserved.</p>
                <p class="footer-bottom-tagline"><%= settings.tagline1 %></p>
            </div>
        </div>
    </footer>

    <!-- Floating Action Buttons -->
    <div class="floating-buttons">
        <a href="https://wa.me/<%= settings.whatsapp.replace(/[^0-9]/g, "") %>" class="float-btn float-whatsapp" target="_blank" aria-label="WhatsApp Us"><i class="fa-brands fa-whatsapp"></i></a>
        <a href="tel:+<%= settings.whatsapp.replace(/[^0-9]/g, "") %>" class="float-btn float-call" aria-label="Call Us"><i class="fa-solid fa-phone"></i></a>
    </div>

    <!-- Custom JS -->
    <script src="/js/script.js"></script>
</body>
</html>
